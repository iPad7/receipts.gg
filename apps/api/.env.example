# apps/api/.env 로 복사해서 사용한다. 실제 비밀값이 담긴 .env 는 커밋하지 않는다.
# DATABASE_URL 과 SESSION_SECRET 이 없으면 애플리케이션은 부팅 시점에 실패한다(의도된 동작).

APP_ENV=local

# compose.yaml 의 로컬 기본 자격 증명과 일치한다.
DATABASE_URL=postgresql+psycopg://receipts:receipts_local_dev@localhost:5432/receipts

# 동기 핸들러가 소비하는 스레드 수와 함께 조정한다.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_CONNECT_TIMEOUT=3

# --- 관리자 인증·세션 (BE-02 / ADR-0004) -------------------------------------

# CSRF 토큰 파생용 HMAC 키. 32자 이상이어야 부팅한다.
# 아래 값은 공개된 자리표시자다. 배포 환경에서는 반드시 새로 생성해서 넣는다.
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=replace-me-with-a-generated-secret-at-least-32-chars

# 세션 쿠키의 Secure 플래그. 운영과 같은 값을 기본으로 둔다.
# APP_ENV=production 이면 false 로 둘 수 없다(부팅 시점 검증).
# 브라우저는 localhost 를 보안 컨텍스트로 취급하므로 로컬 http 개발에서도 동작한다.
# Secure 쿠키를 저장하지 않는 비브라우저 클라이언트로 디버깅할 때만 false 로 바꾼다.
SESSION_COOKIE_SECURE=true

# 유휴 12시간 / 절대 7일. 절대 수명은 갱신되지 않는다.
SESSION_IDLE_SECONDS=43200
SESSION_ABSOLUTE_SECONDS=604800

# 상태 변경 요청의 Origin 허용 목록. 쉼표로 구분한다.
ALLOWED_ORIGINS=http://localhost:3000

# 로그인 속도 제한. 15분 창에서 email 5회 / IP 20회를 넘으면 429.
# 시도 기록은 24시간만 보존한다(IP 는 개인정보 — NFR-009 최소 수집).
LOGIN_ATTEMPT_WINDOW_SECONDS=900
LOGIN_MAX_ATTEMPTS_PER_EMAIL=5
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_ATTEMPT_RETENTION_SECONDS=86400
