# apps/api/.env 로 복사해서 사용한다. 실제 비밀값이 담긴 .env 는 커밋하지 않는다.
# DATABASE_URL 이 없으면 애플리케이션은 부팅 시점에 실패한다(의도된 동작).

APP_ENV=local

# compose.yaml 의 로컬 기본 자격 증명과 일치한다.
DATABASE_URL=postgresql+psycopg://receipts:receipts_local_dev@localhost:5432/receipts

# 동기 핸들러가 소비하는 스레드 수와 함께 조정한다.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_CONNECT_TIMEOUT=3
